{
  "name": "voz-archiver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "tail": "wrangler tail",
    "db:init": "wrangler d1 execute voz-archive --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute voz-archive --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
