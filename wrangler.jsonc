{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voz-archiver",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",

  "observability": {
    "enabled": true
  },

  // Chạy mỗi phút. Không phải vì cần phát hiện thread mới nhanh đến thế —
  // cửa sổ RSS của box đông nhất là ~51 phút — mà vì hạn mức CPU 10 ms của
  // gói Free chỉ cho parse 2-3 trang mỗi lượt, nên phải bù bằng số lượt.
  // Lịch 5 phút cho 288 lượt/ngày, không đủ so với nhu cầu ~1.100 trang/ngày
  // của riêng box 17; lịch 1 phút cho 1.440 lượt, tức ~4.300 trang/ngày.
  // RSS vẫn chỉ hỏi 5 phút một lần, xem RSS_EVERY_MINUTES.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voz-archive",
      "database_id": "8e41806d-e870-4ff5-8ffa-48818190a367"
    }
  ],

  "vars": {
    // Free plan giới hạn 50 subrequest mỗi lượt, và truy vấn D1 cũng tính vào
    // đó chứ không riêng fetch ra ngoài. Mỗi trang tốn 4 (1 fetch + 3 D1),
    // cộng 7 cố định cho RSS và sổ nhật ký.
    "MAX_SUBREQUESTS": "45",
    // Van điều tiết CPU, và là con số đáng cân nhắc nhất ở đây. Đo trên 9
    // trang voz thật: parser chuỗi tốn trung vị 1,5 ms mỗi trang nhưng trang
    // xấu nhất tốn 4,3 ms. Để 2 vì 2 x 4,3 = 8,6 ms vẫn lọt trần 10 ms của
    // gói Free kể cả khi xui gặp liền hai trang nặng; để 3 thì trường hợp đó
    // thành 12,9 ms và Worker bị cắt. Trên gói Paid (30 s) cứ nâng lên vài
    // trăm. Sau khi deploy hãy xem cpuTime thật trong Workers Logs rồi chỉnh.
    "MAX_PAGES_PER_RUN": "2",
    // Trần trang mỗi thread mỗi lượt. Không có nó thì một thread cũ hàng
    // nghìn trang vừa bị đào lên sẽ nuốt sạch ngân sách của cả lượt.
    "MAX_PAGES_PER_THREAD": "2",
    // "fast" là parser chuỗi. "full" và "text" là hai chế độ HTMLRewriter cũ,
    // giữ lại cho /bench đối chiếu, đắt hơn 30-140 lần.
    "PARSE_MODE": "fast",
    // Số thread mới tối đa tải đầy đủ trong một lượt.
    "MAX_NEW_THREADS": "2",
    // Thread cũ hơn ngần này (giờ) thì ngừng kiểm tra reply mới.
    "ACTIVE_WINDOW_HOURS": "72",
    // Cron chạy mỗi phút nhưng RSS chỉ cần hỏi ngần này phút một lần.
    "RSS_EVERY_MINUTES": "5"
  }
}
