{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voz-archiver",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",

  "observability": {
    "enabled": true
  },

  // Hai phút một lượt. Con số này không do CPU quyết định mà do hạn mức ghi
  // của D1 bản free: đo thực tế thì lưu một bài tốn 4 dòng ghi (1 cho bảng
  // posts, 3 cho các bảng ngầm của chỉ mục FTS5), nên trần 100 nghìn dòng
  // mỗi ngày quy ra tối đa 25 nghìn bài. Lịch 1 phút cho ~43 nghìn bài/ngày,
  // vượt gấp 1,7 lần và D1 cắt truy vấn tới 00:00 UTC. Lịch 2 phút cho
  // ~21 nghìn bài, vừa lọt.
  "triggers": {
    "crons": ["*/2 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voz-archive",
      "database_id": "8e41806d-e870-4ff5-8ffa-48818190a367"
    }
  ],

  "vars": {
    // Free plan giới hạn 50 subrequest mỗi lượt, và truy vấn D1 cũng tính vào
    // đó chứ không riêng fetch ra ngoài. Mỗi trang tốn 4 (1 fetch + 3 D1),
    // cộng 7 cố định cho RSS và sổ nhật ký.
    "MAX_SUBREQUESTS": "45",
    // Van điều tiết CPU, và là con số đáng cân nhắc nhất ở đây. Đo trên 9
    // trang voz thật: parser chuỗi tốn trung vị 1,5 ms mỗi trang nhưng trang
    // xấu nhất tốn 4,3 ms. Để 2 vì 2 x 4,3 = 8,6 ms vẫn lọt trần 10 ms của
    // gói Free kể cả khi xui gặp liền hai trang nặng; để 3 thì trường hợp đó
    // thành 12,9 ms và Worker bị cắt. Trên gói Paid (30 s) cứ nâng lên vài
    // trăm. Sau khi deploy hãy xem cpuTime thật trong Workers Logs rồi chỉnh.
    "MAX_PAGES_PER_RUN": "2",
    // Trần trang mỗi thread mỗi lượt. Không có nó thì một thread cũ hàng
    // nghìn trang vừa bị đào lên sẽ nuốt sạch ngân sách của cả lượt.
    "MAX_PAGES_PER_THREAD": "2",
    // "fast" là parser chuỗi. "full" và "text" là hai chế độ HTMLRewriter cũ,
    // giữ lại cho /bench đối chiếu, đắt hơn 30-140 lần.
    "PARSE_MODE": "fast",
    // Số thread mới tối đa tải đầy đủ trong một lượt.
    "MAX_NEW_THREADS": "2",
    // Thread cũ hơn ngần này (giờ) thì ngừng kiểm tra reply mới.
    "ACTIVE_WINDOW_HOURS": "72",
    // RSS chỉ cần hỏi ngần này phút một lần, cửa sổ feed là ~51 phút nên
    // thừa biên. Phải đặt là bội số của chu kỳ cron, nếu không sẽ thưa hơn ý
    // muốn: cron 2 phút chỉ chạy vào phút chẵn, nên để 5 thì RSS hóa ra 10
    // phút một lần chứ không phải 5.
    "RSS_EVERY_MINUTES": "6",
    // Chu kỳ cron ở trên, tính bằng phút. Đổi lịch cron thì đổi cả số này.
    "CRON_EVERY_MINUTES": "2",
    // D1 Free chặn ở 500 MB mỗi database. Không dọn thì kho đầy sau khoảng
    // một tháng. Thread còn sống im quá ngần này ngày thì xóa; thread đã bị
    // voz xóa thì giữ mãi. Đo trên 143 thread đã mất: 97% biến mất trong 14
    // ngày đầu.
    "PRUNE_AFTER_DAYS": "14",
    // Trần mỗi lượt cron. Mỗi bài xóa tốn khoảng 4 dòng ghi (1 cho posts, 3
    // cho FTS5): 15 bài x 720 lượt = ~43 nghìn dòng/ngày nếu lúc nào cũng có
    // gì để dọn, nhưng thực tế chỉ bằng tốc độ bài mới vào.
    "PRUNE_POSTS_PER_RUN": "15"
  }
}
